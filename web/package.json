{
  "name": "workforce-planner-web",
  "private": true,
  "version": "1.0.0",
  "description": "Workforce Planner web app (React). Served by FastAPI from web/dist on http://localhost:8501.",
  "type": "module",
  "scripts": {
    "tokens": "node ../scripts/build_tokens.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:draft4": "tsc --noEmit -p tsconfig.draft4.json && vite build -c vite.draft4.config.ts",
    "dev:draft4": "vite -c vite.draft4.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
